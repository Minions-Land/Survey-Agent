# ===== 必须配置 (Required) =====

# Anthropic API Key - 用于调用 Claude 模型（使用 Claude 时必填）
# 获取地址: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== 其他 LLM Provider（使用对应 Provider 时填写其中一个）=====

# OpenAI GPT 系列
# OPENAI_API_KEY=sk-...

# Google Gemini（OpenAI 兼容端点）
# GEMINI_API_KEY=AIza...

# DeepSeek
# DEEPSEEK_API_KEY=sk-...

# Kimi (Moonshot AI)
# MOONSHOT_API_KEY=sk-...

# Qwen (通义千问/阿里云 DashScope)
# DASHSCOPE_API_KEY=sk-...

# GLM (智谱 AI)
# ZHIPUAI_API_KEY=...

# ===== 搜索 API (Search APIs) =====

# Semantic Scholar API Key - 显著提升速率限制 (100 req/s vs 1 req/s)
# 获取地址: https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# arXiv 无需 API Key，默认启用

# ===== 模型配置 (Model Config) =====

# 廉价模型 - 用于文献结构化提取（大量调用）
CHEAP_MODEL=claude-haiku-4-5

# 高质量模型 - 用于对话、综述撰写
EXPENSIVE_MODEL=claude-opus-4-6

# ===== 研究参数 (Research Parameters) =====

MAX_PAPERS_PER_EXPANSION=20
MAX_TOTAL_PAPERS=200
MAX_FORWARD_HOPS=2
MAX_BACKWARD_HOPS=2

# 分类法更新敏感度: strict | balanced | liberal
TAXONOMY_UPDATE_SENSITIVITY=balanced

# ===== 输出配置 (Output) =====

# 默认输出格式: latex 或 markdown
OUTPUT_FORMAT=latex

# 调研结果输出目录
OUTPUT_DIR=data/surveys

# 本地 PDF 存储目录（留空则不使用本地 PDF）
LOCAL_PAPERS_DIR=data/papers

# ===== 存储路径 (Storage Paths) =====

CHROMA_PERSIST_DIR=data/chroma
